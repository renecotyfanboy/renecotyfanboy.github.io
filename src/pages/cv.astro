---
import type { MarkdownHeading } from "astro";
import PageLayout from "../layouts/PageLayout.astro";
import { tagSlug } from "../utils/posts";

type Entry = {
  when: string;
  /* Optional: an entry can be nothing but its bullets, e.g. peer review. */
  what?: string;
  where?: string;
  href?: string;
  /* Extra plain lines under the entry, e.g. supervisors. */
  notes?: string[];
  /* Bulleted list under the entry, e.g. the journals reviewed for. */
  bullets?: string[];
};

const sections: { title: string; entries: Entry[] }[] = [
  {
    title: "Research experience",
    entries: [
      {
        when: "2023–now",
        what: "Building inference tools for X-ray spectroscopy",
        where: "Post-doctoral researcher, IRAP",
      },
      {
        when: "2020–2023",
        what: "Dynamical assembly of the largest matter halos in the Universe",
        where: "Ph.D Thesis, IRAP & Université de Toulouse",
        notes: ["Supervised by Étienne Pointecouteau & Nicolas Clerc"],
      },
      {
        when: "2020",
        what: "Antistar fraction in the solar neighbourhood",
        where: "Master II internship, IRAP",
      },
      {
        when: "2018",
        what: "Orbital transfer between LLO & NRHO",
        where: "Master I internship, ISAE-Supaero",
      },
      {
        when: "2016",
        what: "Similarity transformations & the nucleon-nucleon interaction",
        where: "Bachelor III internship, CENBG",
      },
    ],
  },
  {
    title: "Education",
    entries: [
      { when: "2020–2023", what: "Ph.D in Astrophysics", where: "IRAP, Toulouse" },
      {
        when: "2018–2020",
        what: "Engineering Master Degree",
        where: "ISAE-Supaero, Toulouse",
      },
      {
        when: "2017–2020",
        what: "Master Degree in Astrophysics",
        where: "Université Toulouse III",
      },
      {
        when: "2015–2016",
        what: "Bachelor Degree in Physics",
        where: "Université Bordeaux I",
      },
      { when: "2013–2016", what: "CPGE PCSI/PC", where: "Lycée René Cassin, Bayonne" },
    ],
  },
  {
    title: "Peer review",
    entries: [
      {
        when: "2026",
        bullets: [
          "Transactions on Pattern Analysis and Machine Intelligence",
          "Open Journal of Astrophysics",
          "Astronomy and Computing",
          "RAS Techniques and Instruments",
          "The Astrophysical Journal",
        ],
      },
      {
        when: "2025",
        bullets: ["Nature Astronomy"],
      },
      {
        when: "2024",
        bullets: [
          "Publications of the Astronomical Society of Australia",
          "Journal of Open Source Software",
        ],
      },
    ],
  },
];

/* One anchor per section; the ToC only appears once there are two or more. */
const headings: MarkdownHeading[] = sections.map((s) => ({
  depth: 2,
  slug: tagSlug(s.title),
  text: s.title,
}));
---

<PageLayout
  title="Curriculum Vitae"
  description="Curriculum vitae"
  headings={headings}
>
  {
    sections.map((section) => (
      <section class="sec">
        <h2 class="title-rule" id={tagSlug(section.title)}>
          {section.title}
        </h2>
        <ol class="entries">
          {section.entries.map((e) => (
            <li>
              <span class="when meta">{e.when}</span>
              <div class="what">
                {(e.what || e.where) && (
                  <p class="line">
                    {e.href ? (
                      <a href={e.href} rel="noopener">
                        {e.what}
                      </a>
                    ) : (
                      e.what
                    )}
                    {e.where && <span class="where">{e.where}</span>}
                  </p>
                )}
                {e.notes?.map((note) => <p class="note">{note}</p>)}
                {e.bullets && (
                  <ul class="bullets">
                    {e.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</PageLayout>

<style>
  .sec + .sec {
    margin-block-start: 3.5rem;
  }

  /* Underline comes from `.title-rule` in global.css. */
  h2 {
    font-size: var(--step-2);
  }

  .entries {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .entries > li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.25rem;
    padding-block: 0.85rem;
    border-block-start: 1px solid var(--line-soft);
  }

  .entries > li:first-child {
    border-block-start: 0;
  }

  .when {
    padding-block-start: 0.32rem;
    color: var(--gold);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .line {
    color: var(--fog-100);
    line-height: 1.5;
  }

  .where {
    display: block;
    margin-block-start: 0.15rem;
    color: var(--fog-400);
    font-size: var(--step--1);
    font-style: italic;
  }

  .note {
    margin-block-start: 0.3rem;
    color: var(--fog-400);
    font-size: 0.78rem;
  }

  /* Bullets carry the entry on their own, so they read at title size. */
  .bullets {
    margin: 0;
    padding-inline-start: 1.2rem;
    list-style: disc;
  }

  .line + .bullets {
    margin-block-start: 0.45rem;
  }

  .bullets li {
    padding-block: 0.18rem;
    color: var(--fog-100);
    line-height: 1.5;
  }

  .bullets li::marker {
    color: var(--gold);
  }

  @media (max-width: 30rem) {
    .entries > li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .when {
      padding-block-start: 0;
    }
  }
</style>
