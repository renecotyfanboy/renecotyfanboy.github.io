---
import type { MarkdownHeading } from "astro";
import PageLayout from "../layouts/PageLayout.astro";
import Publications from "../components/Publications.astro";
import { SCIX_SEARCH } from "../consts";

/* ToC anchors; the ids must match the sections Publications renders. */
const headings: MarkdownHeading[] = [
  { depth: 2, slug: "preprints", text: "Preprints" },
  { depth: 2, slug: "published", text: "Published articles" },
];
---

<PageLayout
  title="Academia"
  headings={headings}
>
  <p class="note">
    Citation counts are refreshed automatically from <a
      href={SCIX_SEARCH}
      rel="noopener">SciX</a
    >.
  </p>
  <Publications />
</PageLayout>

<style>
  .note {
    margin-block-end: 1.5rem;
    color: var(--fog-400);
    font-size: var(--step--1);
  }
</style>
