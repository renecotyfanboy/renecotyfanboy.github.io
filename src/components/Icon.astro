---
interface Props {
  name: "github" | "orcid" | "mail" | "rss" | "arrow" | "external";
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

/* Single-path (or near) glyphs, 24×24 box. Stroked icons use currentColor
   so they inherit link colours; ORCID is a filled brand mark. */
const stroked: Partial<Record<Props["name"], string>> = {
  mail: "M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5zM3.5 7l8.5 6 8.5-6",
  rss: "M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5.5 18.5h.01",
  arrow: "M5 12h14M13 6l6 6-6 6",
  external: "M14 5h5v5M19 5l-8 8M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10",
};

const filled: Partial<Record<Props["name"], string>> = {
  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  orcid:
    "M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zM7.37 18.19H5.62V6.9h1.75zM6.5 5.9a1.08 1.08 0 1 1 0-2.16 1.08 1.08 0 0 1 0 2.16zm5.24 12.29H9.4V6.9h4.02c3.83 0 5.5 2.74 5.5 5.65 0 3.16-2.47 5.64-5.55 5.64zm.06-9.71h-1.6v8.13h1.53c2.18 0 3.57-1.66 3.57-4.06 0-2.43-1.35-4.07-3.5-4.07z",
};

const path = stroked[name] ?? filled[name];
const isStroked = name in stroked;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isStroked ? "none" : "currentColor"}
  stroke={isStroked ? "currentColor" : "none"}
  stroke-width={isStroked ? 1.6 : undefined}
  stroke-linecap={isStroked ? "round" : undefined}
  stroke-linejoin={isStroked ? "round" : undefined}
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
